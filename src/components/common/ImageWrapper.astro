---
// 图片智能包装：本地 src/assets 资源走 Astro 优化管线，public/远程直出
import { Image } from 'astro:assets';
import path from 'node:path';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt = '',
  class: className,
  loading = 'lazy',
  fetchpriority = 'auto',
  widths,
  sizes,
} = Astro.props;

const isLocal = !(src.startsWith('/') || /^https?:/i.test(src) || src.startsWith('data:'));
const normalized = isLocal ? path.normalize(`../../assets/${src}`).replace(/\\/g, '/') : '';
let img: ImageMetadata | null = null;
let svgSrc: string | null = null;
if (isLocal) {
  // 光栅图走 astro:assets 优化管线；SVG 用 ?url 静态导入（避免资源管线随机占位符污染增量构建哈希）
  const rasterFiles = import.meta.glob<ImageMetadata>('../../assets/**/*.{png,jpg,jpeg,webp,avif}', {
    import: 'default',
  });
  const svgFiles = import.meta.glob<string>('../../assets/**/*.svg', {
    import: 'default',
    query: '?url',
  });
  const file = rasterFiles[normalized] ?? svgFiles[normalized];
  if (file) {
    const mod = await file();
    if (typeof mod === 'string') svgSrc = mod;
    else img = mod;
  } else {
    console.error(`[ImageWrapper] 图片不存在: ${normalized}`);
  }
}
---

{img ? (
  <Image
    src={img}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    {...(widths ? { widths } : {})}
    {...(sizes ? { sizes } : {})}
  />
) : svgSrc ? (
  <img src={svgSrc} alt={alt} class={className} loading={loading} fetchpriority={fetchpriority} />
) : (
  <img src={src} alt={alt} class={className} loading={loading} fetchpriority={fetchpriority} />
)}
