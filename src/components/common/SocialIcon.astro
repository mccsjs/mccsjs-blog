const svg = !isImage && !isIconify ? (icons[icon.toLowerCase()] || icons[name.toLowerCase()] || '') : '';
---

{isImage ? (
  <img src={icon} alt={name} class={className} loading="lazy" decoding="async" />
) : isIconify ? (
  <iconify-icon icon={icon} class={className}></iconify-icon>
) : svg ? (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class={className} set:html={svg} />
) : (
  <span class={className}>{name.charAt(0)}</span>
)}

<script>
  import('iconify-icon');
</script>
