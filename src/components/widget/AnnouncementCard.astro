---
import { siteConfig } from '../../config/siteConfig';

const announcement = siteConfig.announcement || '';
const links = siteConfig.announcementLinks || [];
const hostOf = (u: string) => u.replace(/^https?:\/\//, '');
---

<section class="overflow-hidden rounded-2xl border border-[rgb(var(--border)/0.5)] bg-[rgb(var(--surface))] shadow-sm">
  <div class="h-1 w-full bg-gradient-to-r from-[rgb(var(--primary))] to-[rgb(var(--primary)/0.45)]"></div>
  <div class="p-5">
    <h4 class="mb-4 flex items-center gap-2 text-base font-bold text-[rgb(var(--fg))]">
      <iconify-icon icon="ri:megaphone-line" class="h-5 w-5 text-red-500"></iconify-icon>
      公告
    </h4>

    {
      links.length > 0 && (
        <ul class="mb-4 space-y-2 text-sm font-medium text-[rgb(var(--fg))]">
          {links.map((l) => (
            <li class="text-center leading-snug">
              <div>{l.label}：</div>
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[rgb(var(--primary))] hover:underline"
              >
                {hostOf(l.url)}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      announcement && (
        <div class="mb-3 text-sm leading-relaxed text-[rgb(var(--fg-soft))]" set:html={announcement} />
      )
    }

    <div id="welcome-info" class="break-words rounded-[18px] p-2 text-sm leading-relaxed text-[rgb(var(--fg))]">
      <div class="text-center text-[rgb(var(--fg-soft))]">正在获取信息…</div>
    </div>
  </div>
</section>

<style is:global>
  .ip-blur {
    filter: blur(5px);
    transition: filter .2s;
    cursor: pointer;
  }
  .ip-blur:hover {
    filter: none;
  }
</style>

<script>
  const KEY = 'MDKBZ-U7H6J-FBJFY-KD2ON-BDRI5-LIB5L';
  // 站长坐标（南京），用于计算访客距离；按需改成你的坐标
  const HOME = { lng: 118.59232127, lat: 32.78868157 };
  // 缓存 key 带版本，欢迎逻辑改动后旧缓存自动失效（避免浏览器 sessionStorage 残留旧文案）
  const CACHE_KEY = 'welcome-info-v4';

  function getDistance(e1: number, n1: number, e2: number, n2: number): number {
    const R = 6371;
    const { sin, cos, asin, PI, hypot } = Math;
    const getPoint = (e: number, n: number) => {
      e *= PI / 180;
      n *= PI / 180;
      return { x: cos(n) * cos(e), y: cos(n) * sin(e), z: sin(n) };
    };
    const a = getPoint(e1, n1);
    const b = getPoint(e2, n2);
    const c = hypot(a.x - b.x, a.y - b.y, a.z - b.z);
    return Math.round(asin(c / 2) * 2 * R);
  }

  // 时段问候：返回 <span>问候</span>，话术
  function getTimeGreeting(): string {
    const hour = new Date().getHours();
    if (hour >= 5 && hour < 11) return '<span>上午好</span>，一日之计在于晨！';
    if (hour >= 11 && hour < 13) return '<span>中午好</span>，该摸鱼吃午饭了。';
    if (hour >= 13 && hour < 15) return '<span>下午好</span>，懒懒地睡个午觉吧！';
    if (hour >= 15 && hour < 16) return '<span>三点几啦</span>，一起饮茶呀！';
    if (hour >= 16 && hour < 19) return '<span>夕阳无限好！</span>';
    if (hour >= 19 && hour < 24) return '<span>晚上好</span>，夜生活嗨起来！';
    return '夜深了，早点休息，少熬夜。';
  }

  function buildWelcomeHtml(data: any): string {
    const { nation, province, city, district } = data.result.ad_info;
    const pos = nation === '中国'
      ? [province, city, district].filter(Boolean).join(' ')
      : nation;
    const dist = getDistance(HOME.lng, HOME.lat, data.result.location.lng, data.result.location.lat);
    const hi = getTimeGreeting();
    const ip = data.result.ip;
    const c = 'rgb(var(--primary))';
    return (
      `<b><center>🎉 欢迎 🎉</center>&emsp;&emsp;欢迎来自 <span style="color:${c}">${pos}</span> 的小伙伴，` +
      `${hi}您现在距离站长约 <span style="color:${c}">${dist}</span> 公里，当前的IP地址为： <span class="ip-blur" style="color:${c};word-break:break-all">${ip}</span></b>`
    );
  }

  // 腾讯地图 IP 定位（JSONP）
  function fetchIpLocation(): Promise<any> {
    return new Promise((resolve, reject) => {
      const cb = 'welcome_cb_' + Date.now() + Math.floor(Math.random() * 1e4);
      const script = document.createElement('script');
      const cleanup = () => {
        delete (window as any)[cb];
        script.remove();
      };
      (window as any)[cb] = (data: any) => {
        cleanup();
        resolve(data);
      };
      script.onerror = () => {
        cleanup();
        reject(new Error('jsonp error'));
      };
      script.src = `https://apis.map.qq.com/ws/location/v1/ip?key=${KEY}&output=jsonp&callback=${cb}`;
      document.body.appendChild(script);
    });
  }

  async function renderWelcomeInfo() {
    const el = document.getElementById('welcome-info');
    if (!el) return;
    const cached = sessionStorage.getItem(CACHE_KEY);
    if (cached) {
      el.innerHTML = cached;
      return;
    }
    try {
      const data = await fetchIpLocation();
      if (data.status !== 0 || !data.result) return;
      const html = buildWelcomeHtml(data);
      el.innerHTML = html;
      sessionStorage.setItem(CACHE_KEY, html);
    } catch (err) {
      console.error('获取 IP 位置失败:', err);
    }
  }

  // 脚本加载即跑一次（对齐原版 new WelcomeMessage()）；Swup 切页用 swup:page-view，
  // 同时兜底 astro:page-load（Astro 原生 ClientRouter 场景）
  renderWelcomeInfo();
  document.addEventListener('swup:page-view', renderWelcomeInfo);
  document.addEventListener('astro:page-load', renderWelcomeInfo);
</script>
