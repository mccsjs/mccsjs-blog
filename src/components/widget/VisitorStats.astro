---
// 访客统计卡片：纯静态后改用不蒜子（busuanzi）统计站点 PV/UV，
// 数字由 busuanzi 脚本在客户端自动填充（BaseLayout 已引入其脚本）。
---

<div class="vstat-card" id="visitor-stats">
  <div class="vstat-head">
    <div class="vstat-head-text">
      <span class="vstat-tips">网站数据</span>
      <h2 class="vstat-title">访问统计</h2>
    </div>
    <span class="vstat-badge">不蒜子</span>
  </div>

  <div class="vstat-body">
    <div class="vstat-stats">
      <div class="vstat-stat">
        <span class="vstat-lbl">浏览量</span>
        <span class="vstat-num" id="busuanzi_container_site_pv"><span id="busuanzi_value_site_pv">—</span></span>
      </div>
      <div class="vstat-stat">
        <span class="vstat-lbl">访客</span>
        <span class="vstat-num" id="busuanzi_container_site_uv"><span id="busuanzi_value_site_uv">—</span></span>
      </div>
    </div>
  </div>

  <p class="vstat-foot">* 统计由不蒜子提供</p>
</div>

<style>
  .vstat-card {
    position: relative;
    margin: 1.5rem 0;
    padding: 1.25rem 2rem;
    border-radius: 1.5rem;
    background: rgb(var(--glass-bg) / 0.6);
    -webkit-backdrop-filter: blur(16px) saturate(1.6);
    backdrop-filter: blur(16px) saturate(1.6);
    border: 1px solid rgb(var(--glass-border) / 0.45);
    box-shadow: 0 12px 40px -14px rgb(0 0 0 / 0.18);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  .vstat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 56px -16px rgb(0 0 0 / 0.26);
  }
  .vstat-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 100% 0%, rgb(var(--primary) / 0.12), transparent 60%);
    pointer-events: none;
  }
  .vstat-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .vstat-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .vstat-tips {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgb(var(--fg-muted));
  }
  .vstat-title {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    background: linear-gradient(120deg, rgb(var(--primary)), rgb(var(--fg)));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .vstat-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    color: rgb(var(--primary));
    background: rgb(var(--primary) / 0.12);
    border: 1px solid rgb(var(--primary) / 0.25);
    white-space: nowrap;
  }
  .vstat-body {
    display: grid;
    grid-template-columns: minmax(110px, 0.4fr) 2.6fr;
    gap: 2rem;
    align-items: stretch;
  }
  .vstat-stats {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-right: 1.5rem;
    border-right: 1px solid rgb(var(--border) / 0.5);
  }
  .vstat-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    background: rgb(var(--card-bg) / 0.5);
    border: 1px solid rgb(var(--border) / 0.5);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
  }
  .vstat-stat:hover {
    transform: translateX(4px) scale(1.02);
    background: rgb(var(--card-bg) / 0.85);
  }
  .vstat-lbl {
    font-size: 0.82rem;
    color: rgb(var(--fg-muted));
  }
  .vstat-num {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.15;
    color: rgb(var(--fg));
    font-variant-numeric: tabular-nums;
  }
  .vstat-foot {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--border) / 0.4);
    font-size: 0.74rem;
    color: rgb(var(--fg-muted));
  }
  @media (max-width: 820px) {
    .vstat-body {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .vstat-stats {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding-right: 0;
      border-right: none;
      border-bottom: 1px solid rgb(var(--border) / 0.5);
      padding-bottom: 1rem;
    }
    .vstat-stat {
      flex: 1;
      min-width: 0;
      padding: 0.6rem 0.5rem;
    }
  }
</style>
