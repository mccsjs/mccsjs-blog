---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitorStats from '../components/widget/VisitorStats.astro';
import { siteConfig } from '../utils/data';
---

<BaseLayout title="关于" description={siteConfig.description}>
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">关于</h1>
  </section>

  <div class="prose prose-neutral dark:prose-invert max-w-none post-content">
    <p>{siteConfig.description}</p>
    {siteConfig.mottoText && <p class="mt-4">{siteConfig.mottoText}</p>}
  </div>

  <VisitorStats />
</BaseLayout>
