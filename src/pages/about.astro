---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitorStats from '../components/widget/VisitorStats.astro';
import { siteConfig } from '../utils/data';

const author = siteConfig.author;
const socials = author?.socials ?? [];
const keywords = siteConfig.keywords?.join('、') || '';
---

<BaseLayout title="关于" description={siteConfig.description}>
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">关于</h1>
  </section>

  <div class="prose prose-neutral dark:prose-invert max-w-none post-content">
    <h2>站长简介</h2>
    <p>
      你好，这里是 {author?.name || siteConfig.title}。{siteConfig.description}。
    </p>
    <p>
      博客最早基于 Hexo + Butterfly 搭建，又用 Astro 复刻了一版，目前运行在 Astro + 腾讯 EdgeOne
      的纯静态架构上：文章用 Markdown 维护、构建期自动生成页面、评论区由 Twikoo 提供服务。
    </p>

    <h2>联系方式</h2>
    <p>
      交换友链或者随便聊聊，欢迎通过<a href="/contact">联系页</a>找到我
      （邮箱与社交平台均可用）。我一般会在 1~3 天内回复。
    </p>
    <ul>
      {socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
        </li>
      ))}
    </ul>

    <h2>声明</h2>
    <p>
      本站所有原创文章如无特殊说明均采用知识共享署名-非商业性使用-相同方式共享 4.0 国际许可协议，
      转载时请注明出处与原文链接。关于数据处理方式，请参阅<a href="/privacy">隐私声明</a>。
    </p>
  </div>

  <VisitorStats />
</BaseLayout>
