---
import BaseLayout from '../layouts/BaseLayout.astro';
import TabNav from '../components/layout/TabNav.astro';
import type { Post } from '../types';
import { getAllPosts } from '../utils/data';

// 归档每页固定 10 篇，超过自动分页
const PER_PAGE = 10;

const posts: Post[] = await getAllPosts();
let error: string | null = null;

const sorted = posts
  .slice()
  .sort((a, b) => +new Date(+b.createdAt * 1000) - +new Date(+a.createdAt * 1000));

const totalPages = Math.max(1, Math.ceil(sorted.length / PER_PAGE));
const grouped = sorted.reduce<Record<string, Post[]>>((acc, post) => {
  const year = new Date(+post.createdAt * 1000).getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(grouped).sort((a, b) => +b - +a);

// 首屏 SSR 只渲染第 1 页，避免 JS 初始化全量替换造成闪烁
const pagedPosts = sorted.slice(0, PER_PAGE);
const pagedGrouped = pagedPosts.reduce<Record<string, Post[]>>((acc, post) => {
  const year = new Date(+post.createdAt * 1000).getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});
const pagedYears = Object.keys(pagedGrouped).sort((a, b) => +b - +a);

const formatMonthDay = (date: string) =>
  new Date(+date * 1000).toLocaleDateString('zh-CN', {
    month: '2-digit',
    day: '2-digit',
  });

// 分页脚本只需要这些索引字段；不要把每篇文章的完整 Markdown 一起塞进首屏 HTML。
const serializedPosts = JSON.stringify(sorted.map((post) => ({
  slug: post.slug,
  title: post.title,
  createdAt: post.createdAt,
  category: post.category.name,
  tags: post.tags.map((tag) => tag.name),
})));
const serializedTotalPages = JSON.stringify(totalPages);
---

<BaseLayout title="归档" description="按时间线浏览所有文章归档">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">归档</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">
      共 {posts.length} 篇文章，{Object.keys(grouped).length} 个年份
    </p>
  </section>
  <!-- Nav tabs -->
  <TabNav tabs={[
    { label: '文章', href: '/posts' },
    { label: '归档', href: '/archive' },
    { label: '分类', href: '/categories' },
    { label: '标签', href: '/tags' },
  ]} />
  

    

  {
    error ? (
      <div class="rounded-xl border border-red-100 bg-red-50 p-6 text-center text-red-700">
        <p class="font-medium">加载文章失败</p>
        <p class="mt-1 text-sm">{error}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-12 text-center text-[rgb(var(--fg-muted))] dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))] dark:text-[rgb(var(--fg-muted))]">
        暂无文章，稍后再来吧
      </div>
    ) : (
      <div id="archive-root">
        <!-- 分页数据放在当前页面容器中，由常驻入口在 Swup 切页后读取。 -->
        <div
          id="archive-data"
          data-posts={serializedPosts}
          data-total-pages={totalPages}
          data-per-page={PER_PAGE}
          hidden
        ></div>
        <div id="archive-content" class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200 sm:left-6 dark:bg-gray-700"></div>

          <div class="space-y-12">
            {pagedYears.map((year) => (
              <section class="relative">
                <div class="flex items-center gap-4 mb-6">
                  <div class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full bg-yellow-400 text-sm font-bold text-white shadow-sm sm:h-10 sm:w-10 dark:bg-yellow-500">
                    {year.slice(2)}
                  </div>
                  <h2 class="text-2xl font-bold text-[rgb(var(--fg))] dark:text-[rgb(var(--fg))]">{year}</h2>
                  <span class="text-sm text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                    {pagedGrouped[year].length} 篇
                  </span>
                </div>

                <div class="ml-12 space-y-3 sm:ml-16">
                  {pagedGrouped[year].map((post) => (
                    <a
                      href={`/posts/${post.slug}`}
                      class="group flex items-start gap-4 rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
                    >
                      <time class="shrink-0 pt-0.5 text-sm font-medium text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                        {formatMonthDay(post.createdAt)}
                      </time>
                      <div class="min-w-0 flex-1">
                        <h3 class="truncate text-base font-semibold text-[rgb(var(--fg))] group-hover:text-yellow-600 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-400">
                          {post.title}
                        </h3>
                        <div class="mt-1 flex items-center gap-2 text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                          <span class="rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">
                            {post.category.name}
                          </span>
                          {post.tags.length > 0 && (
                            <span class="truncate">
                              {post.tags.map((t) => `#${t.name}`).join(' ')}
                            </span>
                          )}
                        </div>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>

        <nav class="mt-10 flex items-center justify-center gap-3" aria-label="分页导航">
          <button
            id="archive-prev"
            type="button"
            class="rounded-lg border px-4 py-2 text-sm transition-colors hover:border-gray-300 disabled:opacity-40 disabled:cursor-not-allowed"
          >
            上一页
          </button>
          <span id="archive-page-info" class="text-sm text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">
            第 1 / {totalPages} 页
          </span>
          <button
            id="archive-next"
            type="button"
            class="rounded-lg border px-4 py-2 text-sm transition-colors hover:border-gray-300 disabled:opacity-40 disabled:cursor-not-allowed"
          >
            下一页
          </button>
        </nav>
      </div>
    )
  }
</BaseLayout>

<!-- Swup 切换到归档页时也要重新绑定分页按钮事件。 -->
<script data-swup-reload-script define:vars={{ serializedPosts, serializedTotalPages, serializedPerPage: JSON.stringify(PER_PAGE) }}>
  const archiveRoot = document.getElementById('archive-root');
  if (archiveRoot) archiveRoot.dataset.archiveInlineReady = '1';
  const posts = JSON.parse(serializedPosts || '[]');
  const totalPages = Number(serializedTotalPages) || 1;
  const perPage = Number(serializedPerPage) || 10;
  let currentPage = 1;

  const contentEl = document.getElementById('archive-content');
  const prevBtn = document.getElementById('archive-prev');
  const nextBtn = document.getElementById('archive-next');
  const pageInfoEl = document.getElementById('archive-page-info');

  if (!contentEl || !prevBtn || !nextBtn || !pageInfoEl) {
    throw new Error('缺少归档页分页元素');
  }

  function formatMonthDay(date) {
    const d = new Date(+date * 1000);
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${month}-${day}`;
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderPage(page) {
    currentPage = page;
    const start = (page - 1) * perPage;
    const paged = posts.slice(start, start + perPage);

    const grouped = paged.reduce((acc, post) => {
      const year = new Date(+post.createdAt * 1000).getFullYear().toString();
      if (!acc[year]) acc[year] = [];
      acc[year].push(post);
      return acc;
    }, {});

    const years = Object.keys(grouped).sort((a, b) => +b - +a);

    let html = '<div class="absolute left-4 top-0 bottom-0 w-px bg-gray-200 dark:bg-gray-700 sm:left-6"></div>';
    html += '<div class="space-y-12">';

    for (const year of years) {
      html += `
        <section class="relative">
          <div class="flex items-center gap-4 mb-6">
            <div class="relative z-10 flex h-8 w-8 items-center justify-center rounded-full bg-yellow-400 text-sm font-bold text-white shadow-sm sm:h-10 sm:w-10">
              ${year.slice(2)}
            </div>
            <h2 class="text-2xl font-bold text-[rgb(var(--fg))] dark:text-[rgb(var(--fg))]">${year}</h2>
            <span class="text-sm text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
              ${grouped[year].length} 篇
            </span>
          </div>
          <div class="ml-12 space-y-3 sm:ml-16">
      `;

      for (const post of grouped[year]) {
        html += `
          <a
            href="/posts/${escapeHtml(post.slug)}"
            class="group flex items-start gap-4 rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-4 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
          >
            <time class="shrink-0 pt-0.5 text-sm font-medium text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
              ${formatMonthDay(post.createdAt)}
            </time>
            <div class="min-w-0 flex-1">
              <h3 class="truncate text-base font-semibold text-[rgb(var(--fg))] group-hover:text-yellow-600 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-400">
                ${escapeHtml(post.title)}
              </h3>
              <div class="mt-1 flex items-center gap-2 text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                <span class="rounded-full bg-yellow-50 px-2 py-0.5 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">
                  ${escapeHtml(post.category)}
                </span>
                ${post.tags.length > 0 ? `<span class="truncate">${post.tags.map((tag) => `#${escapeHtml(tag)}`).join(' ')}</span>` : ''}
              </div>
            </div>
          </a>
        `;
      }

      html += `
          </div>
        </section>
      `;
    }

    html += '</div>';
    contentEl.innerHTML = html;

    prevBtn.disabled = page <= 1;
    nextBtn.disabled = page >= totalPages;
    pageInfoEl.textContent = `第 ${page} / ${totalPages} 页`;
  }

  prevBtn.addEventListener('click', () => {
    if (currentPage > 1) renderPage(currentPage - 1);
  });

  nextBtn.addEventListener('click', () => {
    if (currentPage < totalPages) renderPage(currentPage + 1);
  });

  // 初始化：同步分页按钮状态与页码信息
  renderPage(1);
</script>
