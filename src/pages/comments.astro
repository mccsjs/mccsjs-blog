---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatRoom from '../components/chat/ChatRoom';
import { getSiteSettings } from '../utils/data';

const settings = getSiteSettings();
const envId = settings.twikooEnvId;
---

<BaseLayout title="留言板" description="在这里给我留言，畅所欲言～" hideBreadcrumb fullWidth flushBottom>
  <div class="page-comments">
    <ChatRoom client:load="react" envId={envId} />
  </div>

  <link rel="stylesheet" href="/fancybox.css" />
  <script is:inline src="/fancybox.umd.js"></script>
</BaseLayout>

<style>
  .page-comments {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    margin-top: -1.5rem;
    height: calc(100dvh - 6rem);
    min-height: 82vh;
    overflow: hidden;
  }

  .page-comments :global(.guestbook-chat) {
    flex: 1 1 auto;
    min-height: 0;
    height: 100%;
    max-width: none;
  }
</style>
