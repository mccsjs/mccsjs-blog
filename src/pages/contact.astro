---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../utils/data';

const socials = siteConfig.author?.socials ?? [];
const email = socials.find((s) => s.url.startsWith('mailto:'))?.url;
---

<BaseLayout title="联系" description="联系站长 — 邮箱与社交平台">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">联系</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">想交流、交换友链或聊聊技术？欢迎来找我</p>
  </section>

  <div class="prose prose-neutral dark:prose-invert max-w-none post-content">
    <h2>邮箱</h2>
    <p>
      最可靠的联系方式是电子邮件：
      {email ? <a href={email}>{email.replace('mailto:', '')}</a> : '见页脚联系方式'}。
      无论是友链申请、技术交流还是文章勘误，都欢迎来信。我一般会在 1~3 天内回复，邮件请尽量说明来意，
      方便我第一时间处理。
    </p>

    <h2>社交平台</h2>
    <p>也可以在这些平台找到我（部分平台回复可能不及时）：</p>
    <ul>
      {socials
        .filter((s) => /^https?:\/\//.test(s.url))
        .map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a> — {s.url}
          </li>
        ))}
    </ul>

    <h2>关于友链</h2>
    <p>
      想和本站交换友链？请先按<a href="/link">友链页</a>的要求添加本站链接，再通过邮箱或留言板告知我。
      我会在看到后尽快添加，并通过友链检测自动为你标注站点状态。
    </p>

    <h2>其它</h2>
    <p>
      留言功能在<a href="/comments">留言板</a>，文章讨论请在对应文章页的评论区进行。
      需要了解本站的数据处理方式，请查看<a href="/privacy">隐私声明</a>。
    </p>
  </div>
</BaseLayout>
