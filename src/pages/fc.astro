---
import BaseLayout from '../layouts/BaseLayout.astro';
import TabNav from '../components/layout/TabNav.astro';
import { getSiteSettings } from '../utils/data';

const settings = getSiteSettings();
// 朋友圈数据源（Friend-Circle-Lite），供常驻脚本读 all.json 渲染文章流
const fcApi = settings.friendCircleApi || 'https://fc.mccsjs.cn/';
---

<BaseLayout title="朋友圈" wide description="友情链接 — 有趣的人与站点，欢迎交换友链">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">朋友圈</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">友链们的最新文章</p>
  </section>

  <TabNav tabs={[
    { label: '友链', href: '/link' },
    { label: '朋友圈', href: '/fc' },
  ]} />

  {/* 文章流：由常驻脚本 friend-circle.js 拉 all.json 客户端渲染（统计条 + 卡片网格 + 加载更多） */}
  <div id="fc-root" data-api={fcApi}>
    <div id="fc-stats" class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">正在加载朋友圈…</div>
    <div id="fc-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <button id="fc-more" hidden class="mt-8 w-full rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] px-4 py-2.5 text-sm text-[rgb(var(--fg-soft))] shadow-sm transition-colors hover:text-[rgb(var(--fg))] dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]">再来亿点</button>
  </div>
</BaseLayout>
