---
import BaseLayout from '../layouts/BaseLayout.astro';
import TabNav from '../components/layout/TabNav.astro';
import { getFriends } from '../utils/data';

interface FriendItem {
  id: string;
  name: string;
  url: string;
  description: string;
  avatar: string;
  screenshot?: string;
}

interface FriendGroup {
  type_name: string;
  friends: FriendItem[];
}

// 本地友链数据按类型分组
const allFriends = getFriends();
const groups: FriendGroup[] = [];
for (const f of allFriends) {
  const t = f.type || '友链';
  let g = groups.find((x) => x.type_name === t);
  if (!g) {
    g = { type_name: t, friends: [] };
    groups.push(g);
  }
  g.friends.push({
    id: f.id,
    name: f.name,
    url: f.url,
    description: f.description,
    avatar: f.avatar,
    screenshot: f.screenshot,
  });
}
---

<BaseLayout title="朋友圈" wide description="友情链接 — 有趣的人与站点，欢迎交换友链">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">朋友圈</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">有趣的人与站点</p>
  </section>

  <TabNav tabs={[
    { label: '友链', href: '/link' },
    { label: '朋友圈', href: '/fc' },
  ]} />

  {
    groups.length === 0 ? (
      <div class="rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-12 text-center text-[rgb(var(--fg-muted))] dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))] dark:text-[rgb(var(--fg-muted))]">
        暂无友链，稍后再来吧
      </div>
    ) : (
      groups.map((group) => (
        <section class="mb-12">
          <h2 class="mb-5 text-lg font-bold text-[rgb(var(--fg))] dark:text-[rgb(var(--fg))]">{group.type_name}</h2>
          <div class="grid gap-4 grid-cols-2 lg:grid-cols-6">
            {group.friends.map((friend) => (
              <a
                href={friend.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block overflow-hidden rounded-2xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
              >
                <div class="flex items-start gap-2.5 p-3">
                  <div class="h-10 w-10 shrink-0 rounded-full border border-[rgb(var(--card-border))] bg-[rgb(var(--bg-soft))] dark:border-[rgb(var(--card-border))] dark:bg-gray-800">
                    {friend.avatar ? (
                      <img src={friend.avatar} alt={friend.name} class="h-full w-full rounded-full object-cover" loading="lazy" />
                    ) : (
                      <span class="text-xs font-bold text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))] flex h-full items-center justify-center">{friend.name.charAt(0)}</span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <h3 class="truncate text-sm font-semibold text-[rgb(var(--fg))] group-hover:text-yellow-700 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-300">{friend.name}</h3>
                    <p class="mt-0.5 line-clamp-2 text-xs leading-snug text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">{friend.description || friend.url}</p>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    )
  }
</BaseLayout>
