---
import BaseLayout from '../layouts/BaseLayout.astro';
import TwikooComments from '../components/comment/TwikooComments.astro';
import TabNav from '../components/layout/TabNav.astro';
import { getFriends, getSiteSettings } from '../utils/data';
import { renderMarkdown } from '../utils/markdown';

interface FriendItem {
  id: string;
  name: string;
  url: string;
  description: string;
  avatar: string;
  screenshot?: string;
  speedtest?: boolean;
}

interface FriendGroup {
  type_name: string;
  friends: FriendItem[];
}

const settings = getSiteSettings();
const linkMarkdown = settings.linkMarkdown || '';
// 友链检测数据源（Friend-Circle-Lite），供常驻脚本读 link.json 填充胶囊
const fcApi = settings.friendCircleApi || 'https://fc.mccsjs.cn/';

// 本地友链数据按类型分组
const allFriends = getFriends();
const groups: FriendGroup[] = [];
for (const f of allFriends) {
  const t = f.type || '友链';
  let g = groups.find((x) => x.type_name === t);
  if (!g) {
    g = { type_name: t, friends: [] };
    groups.push(g);
  }
  g.friends.push({
    id: f.id,
    name: f.name,
    url: f.url,
    description: f.description,
    avatar: f.avatar,
    screenshot: f.screenshot,
    speedtest: f.speedtest,
  });
}

const isLostGroup = (name: string) => /失联/.test(name);

let linkMarkdownHtml = '';
if (linkMarkdown) {
  const res = await renderMarkdown(linkMarkdown);
  linkMarkdownHtml = res.html;
}
---

<BaseLayout title="友链" wide showComment={true} description="友情链接 — 有趣的人与站点，欢迎交换友链">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">友情链接</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">有趣的人与站点，欢迎交换友链</p>
  </section>

  <TabNav tabs={[
    { label: '友链', href: '/link' },
    { label: '朋友圈', href: '/fc' },
  ]} />

  {
    groups.length === 0 ? (
      <div class="rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-12 text-center text-[rgb(var(--fg-muted))] dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))] dark:text-[rgb(var(--fg-muted))]">
        暂无友链，稍后再来吧
      </div>
    ) : (
      groups.map((group) => {
        const lost = isLostGroup(group.type_name);
        return (
          <section class="mb-12">
            <h2 class="mb-5 text-lg font-bold text-[rgb(var(--fg))] dark:text-[rgb(var(--fg))]">
              {group.type_name}
            </h2>
            {lost ? (
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                {group.friends.map((friend) => (
                  <span class="text-sm text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">{friend.name}</span>
                ))}
              </div>
            ) : (
              <div class="grid gap-4 grid-cols-2 lg:grid-cols-6">
                {group.friends.map((friend) => (
                  <a
                    href={friend.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group block overflow-hidden rounded-2xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
                  >
                    <div class="relative h-32 w-full overflow-hidden bg-gray-100 dark:bg-gray-800">
                      {friend.screenshot ? (
                        <Fragment>
                          <img src={friend.screenshot} alt={friend.name} class="friend-shot h-full w-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105" loading="lazy" decoding="async" onerror="this.style.display='none'; this.parentElement.querySelector('.shot-fallback').style.display='flex';" />
                          <div class="shot-fallback hidden h-full w-full items-center justify-center text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">暂无截图</div>
                        </Fragment>
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">暂无截图</div>
                      )}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
                      {/* 友链检测胶囊：speedtest:false 显示绿色"在线"静态胶囊；其余由 friend-circle.js 拉 link.json 填充 */}
                      {friend.speedtest === false ? (
                        <div class="absolute top-1 left-1 flex items-center gap-0.5 rounded-full bg-green-500/90 px-1 py-px text-[9px] font-medium text-white shadow-sm">在线</div>
                      ) : (
                        <div class="absolute top-1 left-1" data-friend-pill data-name={friend.name} data-url={friend.url}></div>
                      )}
                    </div>
                    <div class="flex items-start gap-2.5 py-1 px-2 h-[54px]">
                      <div class="h-9 w-9 shrink-0 -ml-1 overflow-hidden rounded-full border border-[rgb(var(--card-border))] bg-[rgb(var(--bg-soft))] dark:border-[rgb(var(--card-border))] dark:bg-gray-800">
                        {friend.avatar ? (
                          <Fragment>
                            <img src={friend.avatar} alt={friend.name} class="h-full w-full rounded-full object-cover" loading="lazy" decoding="async" onerror="this.style.display='none'; this.parentElement.querySelector('.avatar-fallback').style.display='flex';" />
                            <span class="avatar-fallback hidden text-[10px] font-bold text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))] flex h-full items-center justify-center">{friend.name.charAt(0)}</span>
                          </Fragment>
                        ) : (
                          <span class="text-[10px] font-bold text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))] flex h-full items-center justify-center">{friend.name.charAt(0)}</span>
                        )}
                      </div>
                      <div class="min-w-0">
                        <h3 class="truncate text-xs font-semibold text-[rgb(var(--fg))] group-hover:text-yellow-700 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-300">
                          {friend.name}
                        </h3>
                        <p class="mt-0 line-clamp-2 text-xs leading-snug text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                          {friend.description || friend.url}
                        </p>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </section>
        );
      })
    )
  }

  {
    linkMarkdownHtml && (
      <section id="link-markdown-section" class="mb-10">
        <div class="prose max-w-none rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-6 shadow-sm dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
          set:html={linkMarkdownHtml}
        ></div>
      </section>
    )
  }

  <section id="comments" class="mt-14">
    <h2 class="text-2xl font-bold">评论</h2>
    <div class="mt-6">
      <TwikooComments />
    </div>
  </section>
  {/* 友链检测数据源配置（friend-circle.js 读取） */}
  <div id="fc-link-config" data-api={fcApi} hidden></div>
  <style>
    /* 友链截图：默认 opacity-0，全局懒加载脚本标记 is-loaded 后淡入。
       淡入逻辑统一由 BaseLayout 全局脚本处理（兼容 Swup 客户端导航）。 */
    .friend-shot.is-loaded {
      opacity: 1;
    }
  </style>
</BaseLayout>
