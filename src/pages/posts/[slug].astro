---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TwikooComments from '../../components/comment/TwikooComments.astro';
import CopyrightCard from '../../components/common/CopyrightCard.astro';
import type { MarkdownHeading } from 'astro';
import type { Post } from '../../types';
import { getPostBySlug, getAllPosts, getAllPostsForRoutes, getSiteSettings } from '../../utils/data';
import { renderMarkdown } from '../../utils/markdown';
import { siteConfig } from '../../config/siteConfig';

const settings = getSiteSettings();
const siteTitle = settings.siteTitle || 'My Blog';
const siteLogo = settings.siteLogo || '';

// 将相对路径转成绝对 URL（供 JSON-LD 的 image / publisher.logo 使用）
const toAbsolute = (url?: string) => {
  if (!url) return undefined;
  return url.startsWith('http') ? url : new URL(url, Astro.url.origin).href;
};

export async function getStaticPaths() {
  const posts = await getAllPostsForRoutes();
  const sorted = posts.slice().sort((a, b) => Number(a.createdAt) - Number(b.createdAt));
  return sorted.map((post, i) => {
    const prev = i > 0 ? sorted[i - 1] : null;
    const next = i < sorted.length - 1 ? sorted[i + 1] : null;
    const key = [post.digest, prev?.digest ?? '', next?.digest ?? ''].join('|');
    return { params: { slug: post.slug }, cacheKey: key };
  });
}

const { slug } = Astro.params;

let post: Post | null = null;
let allPosts: Post[] = [];
let error: string | null = null;

post = await getPostBySlug(slug);
if (!post) {
  error = '未找到该文章';
} else {
  allPosts = await getAllPosts();
}

// 按创建时间排序，计算上一篇/下一篇
const sortedPosts = allPosts
  .slice()
  .sort((a, b) => +new Date(+a.createdAt * 1000) - +new Date(+b.createdAt * 1000));
const currentIndex = sortedPosts.findIndex((p) => p.slug === slug);
const prev = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const next =
  currentIndex >= 0 && currentIndex < sortedPosts.length - 1
    ? sortedPosts[currentIndex + 1]
    : null;

const formatDate = (date: string) =>
  new Date(+date * 1000).toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

// 估算阅读时间：中文按字、英文按词
const getReadingTime = (content: string) => {
  const chinese = (content.match(/[\u4e00-\u9fa5]/g) || []).length;
  const words = (content.match(/[a-zA-Z0-9_]+/g) || []).length;
  return Math.max(1, Math.ceil((chinese + words) / 300));
};

const readTime = post ? getReadingTime(post.content) : 0;

// 总字数：中文按字、英文按词，与阅读时间统计口径一致
const wordCount = post
  ? (() => {
      const chinese = (post.content.match(/[\u4e00-\u9fa5]/g) || []).length;
      const words = (post.content.match(/[a-zA-Z0-9_]+/g) || []).length;
      return chinese + words;
    })()
  : 0;

// 渲染 Markdown（Sätteri + Shiki）；旧文章若是纯 HTML 则原样输出
// 仅当“几乎全是 HTML”才原样输出：以 < 开头且不含明显 Markdown 块语法（标题/代码块/列表），
// 否则走 Markdown 渲染（内嵌的 <details>/<img> 等原生 HTML 会被正常保留）
const looksLikeHtml = (s: string) => {
  if (!/^\s*</.test(s)) return false;
  if (/^#{1,6}\s/m.test(s) || /```/.test(s) || /^\s*[-*+]\s/m.test(s)) return false;
  return /<\/[a-z]+>/i.test(s);
};

const rendered = post
  ? looksLikeHtml(post.content)
    ? { html: post.content, headings: [] as MarkdownHeading[] }
    : await renderMarkdown(post.content)
  : null;

const contentHtml = rendered?.html ?? '';

const slugify = (text: string) =>
  text
    .trim()
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .replace(/\s+/g, '-');

const escapeHtml = (str) =>
  String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

const withFancybox = (html) => {
  if (!html) return html;
  return html.replace(/<img\b[^>]*>/g, (match, offset) => {
    if (match.includes('data-fancybox=')) return match;
    const before = html.slice(0, offset);
    const lastOpenA = before.lastIndexOf('<a');
    const lastCloseA = before.lastIndexOf('</a>');
    if (lastOpenA > lastCloseA) return match;
    const srcMatch = match.match(/\ssrc=(".*?"|'.*?'|[^\s>]+)/);
    const src = srcMatch ? srcMatch[1].replace(/^['"]|['"]$/g, '').replace(/`/g, '') : '';
    if (!src) return match;
    const altMatch = match.match(/\salt=(".*?"|'.*?'|[^\s>]+)/);
    const alt = altMatch ? altMatch[1].replace(/^['"]|['"]$/g, '') : '';
    const titleMatch = match.match(/\stitle=(".*?"|'.*?'|[^\s>]+)/);
    const title = titleMatch ? titleMatch[1].replace(/^['"]|['"]$/g, '') : '';
    const attrs = match.replace(/^<img\s*/, '').replace(/>$/, '').replace(/\s+$/, '');
    const cleanAttrs = attrs.replace(/\ssrc=(".*?"|'.*?'|[^\s>]+)/g, '').replace(/\s+/g, ' ').trim();
    const extraAttrs = cleanAttrs ? ' ' + cleanAttrs : '';
    const safeSrc = escapeHtml(src);
    const safeAlt = escapeHtml(alt);
    const safeTitle = escapeHtml(title);
    return `<a href="${safeSrc}" data-fancybox="gallery" data-caption="${safeAlt}" class="block"><img src="${safeSrc}" alt="${safeAlt}"${safeTitle ? ` title="${safeTitle}"` : ''} loading="lazy" class="w-full rounded-xl"${extraAttrs} /></a>`;
  }).replace(/>\s*\/&gt;\s*</g, '><');
};

const contentHtmlReady = withFancybox(contentHtml);

// JSON-LD 结构化数据
const cleanDescription = (raw: string) =>
  (raw || '')
    .replace(/<[^>]+>/g, '')      // 去掉 HTML 标签
    .replace(/\{%.*?%\}/g, '')    // 去掉 Jekyll 标签 {% ... %}
    .replace(/`{1,3}[^`]*`{1,3}/g, '') // 去掉行内代码
    .replace(/[#*_~\[\]()>|]/g, '')    // 去掉 Markdown 语法字符
    .replace(/\n+/g, ' ')         // 换行转空格
    .replace(/\s+/g, ' ')         // 压缩空白
    .trim()
    .slice(0, 200);
const postUrl = post ? `${Astro.url.origin}/posts/${post.slug}` : '';
const jsonLd = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: cleanDescription(post.excerpt || post.content),
  image: siteConfig.generateOgImages
    ? `${Astro.url.origin}/og/${post.slug}.png`
    : (toAbsolute(post.coverImage) || (siteLogo ? toAbsolute(siteConfig.favicon.src) : undefined)),
  datePublished: new Date(+post.createdAt * 1000).toISOString(),
  dateModified: post.updatedAt ? new Date(+post.updatedAt * 1000).toISOString() : undefined,
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Person',
    name: post.author?.name || siteTitle,
    url: Astro.url.origin,
  },
  publisher: {
    '@type': 'Organization',
    name: siteTitle,
    logo: siteLogo
      ? { '@type': 'ImageObject', url: toAbsolute(siteConfig.favicon.src) }
      : undefined,
  },
  keywords: post.tags?.map(t => t.name) || [],
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
} : null;


// 提取目录（h1/h2/h3）并构建 Butterfly 风格嵌套 ol/li 结构
interface TocItem {
  depth: number;
  text: string;
  slug: string;
  children?: TocItem[];
}

const tocFlat: { depth: number; text: string; slug: string }[] = [];
if (post) {
  if (rendered && rendered.headings.length) {
    // Sätteri 已生成标题 id，直接采用（slug 与渲染出的 id 一致）
    for (const h of rendered.headings) {
      if (h.depth >= 1 && h.depth <= 3) {
        tocFlat.push({ depth: h.depth, text: h.text, slug: h.slug });
      }
    }
  } else if (contentHtml) {
    // 纯 HTML 原文回退：用正则提取 + 本地 slugify（与下方 id 生成一致）
    const headingRegex = /<h([123])[^>]*>(.*?)<\/h\1>/g;
    let m;
    while ((m = headingRegex.exec(contentHtml)) !== null) {
      const depth = parseInt(m[1], 10);
      const text = m[2].replace(/<[^>]+>/g, '');
      const slug = slugify(text);
      if (text && slug) tocFlat.push({ depth, text, slug });
    }
  }
}

function buildTocTree(items: typeof tocFlat): TocItem[] {
  if (!items.length) return [];
  const roots: TocItem[] = [];
  const stack: TocItem[] = [{ depth: 0, text: '', slug: '', children: roots }];
  for (const item of items) {
    const node: TocItem = { depth: item.depth, text: item.text, slug: item.slug, children: [] };
    while (stack.length > 1 && stack[stack.length - 1].depth >= node.depth) stack.pop();
    const parent = stack[stack.length - 1];
    if (!parent.children) parent.children = [];
    parent.children.push(node);
    stack.push(node);
  }
  return roots;
}

function renderTocOl(nodes: TocItem[]): string {
  return nodes.map((item) => {
    const hasChildren = item.children && item.children.length > 0;
    let html = '<li class="toc-item toc-level-' + item.depth + '" data-toc-slug="' + item.slug + '">';
    html += '<a href="#' + item.slug + '" class="toc-link">' + item.text + '</a>';
    if (hasChildren) html += '<ol class="toc-child">' + renderTocOl(item.children!) + '</ol>';
    html += '</li>';
    return html;
  }).join('');
}

const tocTree = buildTocTree(tocFlat);
const tocHtmlStr = tocTree.length > 0 ? '<ol class="toc-list">' + renderTocOl(tocTree) + '</ol>' : '';
---

<BaseLayout
  title={post?.title || '文章详情'}
  description={post ? cleanDescription(post.excerpt || post.content) : undefined}
  wide={true}
  postSlug={slug}
  postCategory={post?.category?.name}
  showToc={tocTree.length > 0}
  ogType="article"
>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {post && (
    <Fragment slot="head">
      <meta property="article:published_time" content={new Date(+post.createdAt * 1000).toISOString()} />
      <meta property="article:modified_time" content={new Date(+(post.updatedAt || post.createdAt) * 1000).toISOString()} />
      {post.category?.name && <meta property="article:section" content={post.category.name} />}
      {post.tags?.map(tag => <meta property="article:tag" content={tag.name} />)}
    </Fragment>
  )}
  {/* 阅读进度条 */}
  <div class="reading-progress fixed left-0 top-0 z-50 h-1 bg-yellow-400" style="width: 0%;"></div>

  {
    error || !post ? (
      <div class="rounded-xl border border-red-100 bg-red-50 p-8 text-center text-red-700">
        <h1 class="text-xl font-bold">文章加载失败</h1>
        <p class="mt-2 text-sm">{error || '未找到该文章'}</p>
        <a href="/posts" class="mt-4 inline-block text-sm font-medium text-yellow-600 hover:underline">
          返回文章列表
        </a>
      </div>
    ) : (
      <div class="w-full">
        <a
          href="/posts"
          class="mb-6 inline-flex items-center gap-1 text-sm text-[rgb(var(--fg-muted))] hover:text-yellow-600 dark:text-[rgb(var(--fg-muted))] dark:hover:text-yellow-400 transition-colors"
        >
          <span>←</span>
          返回文章列表
        </a>

        <div class={tocTree.length > 0 ? 'grid gap-8 lg:grid-cols-[2fr_280px] lg:gap-12' : 'mx-auto max-w-3xl'}>
          <article class="post-article">
            <header class="mb-8 text-center">
              <div class="flex flex-wrap items-center justify-center gap-2 text-sm text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))]">
                <span class="rounded-full bg-yellow-50 px-2.5 py-1 font-medium text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400">
                  {post.category.name}
                </span>
                <span>·</span>
                <time datetime={post.createdAt}>{formatDate(post.createdAt)}</time>
                <span>·</span>
                <span id="busuanzi_container_page_pv"><span id="busuanzi_value_page_pv">0</span> 次阅读</span>
                <span>·</span>
                <span>{readTime} 分钟</span>
                <span>·</span>
                <span>总字数 {wordCount >= 10000 ? `${(wordCount / 10000).toFixed(1)}w` : wordCount.toLocaleString('zh-CN')}</span>
              </div>
              <h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">{post.title}</h1>
              {post.excerpt && (
                <p class="mt-4 text-lg text-[rgb(var(--fg-soft))] leading-relaxed dark:text-[rgb(var(--fg-muted))]">{post.excerpt}</p>
              )}
            </header>

            <div class="post-content prose prose-base max-w-none border-t pt-8 dark:border-[rgb(var(--border))]" set:html={contentHtmlReady}></div>

            {
              post.tags.length > 0 && (
                <div class="mt-10 flex flex-wrap items-center gap-2 border-t pt-6 dark:border-[rgb(var(--card-border))]">
                  <span class="text-sm font-medium text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">标签：</span>
                  {post.tags.map((tag) => (
                    <span class="rounded-full border border-[rgb(var(--card-border))] px-3 py-1 text-sm text-[rgb(var(--fg-soft))] dark:border-[rgb(var(--card-border))] dark:text-[rgb(var(--fg-muted))]">#{tag.name}</span>
                  ))}
                </div>
              )
            }

            {/* 上下篇 */}
            <nav class="no-print mt-10 grid gap-4 sm:grid-cols-2">
              {prev && (
                <a
                  href={`/posts/${prev.slug}`}
                  class="group rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]"
                >
                  <div class="text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))] mb-1">← 上一篇</div>
                  <div class="font-medium text-[rgb(var(--fg))] group-hover:text-yellow-600 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-400 line-clamp-2">
                    {prev.title}
                  </div>
                </a>
              )}
              {next && (
                <a
                  href={`/posts/${next.slug}`}
                  class={`group rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))] text-right ${!prev ? 'sm:col-start-2' : ''}`}
                >
                  <div class="text-xs text-[rgb(var(--fg-muted))] dark:text-[rgb(var(--fg-muted))] mb-1">下一篇 →</div>
                  <div class="font-medium text-[rgb(var(--fg))] group-hover:text-yellow-600 dark:text-[rgb(var(--fg))] dark:group-hover:text-yellow-400 line-clamp-2">
                    {next.title}
                  </div>
                </a>
              )}
            </nav>

            {/* 版权卡片 */}
            <CopyrightCard
              title={post.title}
              authorName={siteTitle}
              authorHref="/"
              postUrl={`${Astro.url.origin}/posts/${post.slug}`}
              publishedAt={formatDate(post.createdAt)}
              licenseName="CC BY-NC-SA 4.0"
            />

            {/* 评论 */}
            <section class="mt-14">
              <h2 class="text-2xl font-bold">评论</h2>
              <div class="mt-6">
                <TwikooComments />
              </div>
            </section>
          </article>

          {/* 文章目录 */}
          {tocTree.length > 0 && (
            <aside id="post-toc" class="hidden lg:block">
              <div id="post-toc-inner" class="mt-20 w-[260px] max-h-[calc(100vh-10rem)] overflow-y-auto rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-5 shadow-sm dark:border-[rgb(var(--card-border))] dark:bg-[rgb(var(--card-bg))]">
                <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-yellow-600 dark:text-yellow-400">
                  目录
                </h4>
                <nav id="toc-list" class="text-sm" set:html={tocHtmlStr} />
              </div>
            </aside>
          )}
        </div>
      </div>
    )
  }
</BaseLayout>
