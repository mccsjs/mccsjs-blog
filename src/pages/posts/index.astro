---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/layout/PostCard.astro';
import TabNav from '../../components/layout/TabNav.astro';
import type { Post } from '../../types';
import { getAllPosts, getSiteSettings } from '../../utils/data';

const settings = getSiteSettings();
const postsPerPage = Math.min(100, Math.max(1, Number(settings.postsPerPage) || 10));
const PER_PAGE = postsPerPage;

const posts: Post[] = await getAllPosts();
let error: string | null = null;

const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));

// ====== SSR 分页条渲染（不依赖 JS） ======
function pageList(cur: number, total: number): (number | '…')[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const set = new Set([1, total, cur - 1, cur, cur + 1]);
  const arr = [...set].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
  const out: (number | '…')[] = [];
  let prev = 0;
  for (const p of arr) { if (p - prev > 1) out.push('…'); out.push(p); prev = p; }
  return out;
}
---

<BaseLayout title="文章" description="浏览全部文章，按时间倒序排列">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">全部文章</h1>
    <p class="mt-3 text-[rgb(var(--fg-soft))] dark:text-[rgb(var(--fg-muted))]">共 {posts.length} 篇文章</p>
  </section>
  <TabNav tabs={[
    { label: '文章', href: '/posts' },
    { label: '归档', href: '/archive' },
    { label: '分类', href: '/categories' },
    { label: '标签', href: '/tags' },
  ]} />

  {
    error ? (
      <div class="rounded-xl border border-red-100 bg-red-50 p-6 text-center text-red-700">
        <p class="font-medium">加载文章失败</p>
        <p class="mt-1 text-sm">{error}</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="rounded-xl border border-[rgb(var(--card-border))] bg-[rgb(var(--card-bg))] p-12 text-center text-[rgb(var(--fg-muted))]">
        暂无文章，稍后再来吧
      </div>
    ) : (
      <>
        <div id="posts-grid" class="grid min-w-0 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <div class={`post-item min-w-0${i < PER_PAGE ? '' : ' hidden'}`} data-index={i}>
              <PostCard post={post} />
            </div>
          ))}
        </div>

        {/* SSR 分页条 —— 即使 JS 不执行也保证可见；交互由公共脚本 pagination.js 处理 */}
        {totalPages > 1 && (
          <nav id="posts-pagination" data-per-page={PER_PAGE} class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="分页导航">
            <button type="button" data-nav="prev" disabled class="inline-flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm font-medium transition-all duration-200 border-[rgb(var(--card-border))] text-[rgb(var(--fg))] hover:-translate-y-0.5 hover:border-[rgb(var(--primary))] hover:text-[rgb(var(--primary))] opacity-40 pointer-events-none">上一页</button>
            {pageList(1, totalPages).map((p) =>
              p === '…' ? (
                <span class="inline-flex h-10 min-w-10 items-center justify-center rounded-xl px-3 text-sm">…</span>
              ) : (
                <button type="button" data-page={p} class={`inline-flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm font-medium transition-all duration-200 ${p === 1 ? 'border-[rgb(var(--primary))] bg-[rgb(var(--primary))] text-white' : 'border-[rgb(var(--card-border))] text-[rgb(var(--fg))] hover:-translate-y-0.5 hover:border-[rgb(var(--primary))] hover:text-[rgb(var(--primary))]'}`}>{p}</button>
              )
            )}
            <button type="button" data-nav="next" class="inline-flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm font-medium transition-all duration-200 border-[rgb(var(--card-border))] text-[rgb(var(--fg))] hover:-translate-y-0.5 hover:border-[rgb(var(--primary))] hover:text-[rgb(var(--primary))]">下一页</button>
          </nav>
        )}
      </>
    )
  }
</BaseLayout>
